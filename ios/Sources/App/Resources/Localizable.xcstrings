      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入…"
          }
        }
      }
    },
    "More settings arrive in the next builds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多设置将在后续版本中加入。"
          }
        }
      }
    },
    "No chapters were found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到章节。"

      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录"
          }
        }
      }
    },
    "Couldn't open this chapter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开这一章。"
          }
        }
      }
    },
    "Couldn't read the file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件。"
          }
        }
      }
    },
    "Current chapter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前章节"
          }
        }
      }
    },
    "EPUB and TXT files from Files, iCloud Drive or a USB drive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可从“文件”、iCloud 云盘或 U 盘导入 EPUB 和 TXT 文件。"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入失败"
          }
        }
      }
    },
    "Fixed-layout books aren't supported yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持固定版式的书。"
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        }
      }
    },
    "Import EPUB or TXT books to start reading.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 EPUB 或 TXT 书籍开始阅读。"
          }
        }
      }
    },
    "Import books": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去导入"
          }
        }
      }
    },

      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此书受 DRM 保护，无法导入。"
          }
        }
      }
    },
    "Too large (over %@).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大（超过 %@）。"
          }
